.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/
*.duckdb
*.duckdb.wal
.streamlit/secrets.toml

# Generated or downloaded data is ignored by default. Small reviewed fixtures
# and representative evidence can be force-added deliberately.
data/raw/*
!data/raw/.gitkeep
data/canonical/*
!data/canonical/.gitkeep
data/output/*
!data/output/.gitkeep
